--- /dev/null
+++ b/apps/web/src/core/connections/haAutoConnect.ts
@@ -0,0 +1,23 @@
+import type { Connection } from "@core/stores/deviceStore/types.ts";
+
+const HA_CONNECTION_NAME = "Home Assistant";
+
+/**
+ * The Home Assistant integration serves this app with `?path=<proxy path>`.
+ * Returns the absolute URL of that proxy, or undefined when the app was
+ * opened without it.
+ */
+export function getProxyUrlFromQuery(): string | undefined {
+  const path = new URLSearchParams(globalThis.location.search).get("path");
+  if (!path?.startsWith("/") || path.startsWith("//")) return undefined;
+  return `${globalThis.location.origin}${path.replace(/\/+$/, "")}`;
+}
+
+export function isProxyConnection(
+  conn: Connection,
+  url: string,
+): conn is Connection & { type: "http"; url: string } {
+  return conn.type === "http" && conn.url === url;
+}
+
+export { HA_CONNECTION_NAME };
