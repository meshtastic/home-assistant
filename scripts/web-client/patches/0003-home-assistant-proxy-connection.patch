index 0000000..afe2eec
--- /dev/null
+++ b/apps/web/src/components/HomeAssistantAutoConnect.tsx
@@ -0,0 +1,37 @@
+import {
+  getProxyUrlFromQuery,
+  HA_CONNECTION_NAME,
+  isProxyConnection,
+} from "@core/connections/haAutoConnect.ts";
+import { useDeviceStore } from "@core/stores";
+import { useConnections } from "@pages/Connections/useConnections.ts";
+import { useEffect } from "react";
+
+let started = false;
+
+/** Connects to the Home Assistant proxy named by `?path=` once per page load. */
+export function HomeAssistantAutoConnect() {
+  const { connect, addConnectionAndConnect } = useConnections();
+
+  useEffect(() => {
+    const url = getProxyUrlFromQuery();
+    if (!url || started) return;
+    started = true;
+
+    const { savedConnections, updateSavedConnection } =
+      useDeviceStore.getState();
+    const existing = savedConnections.find((c) => isProxyConnection(c, url));
+    if (existing) {
+      updateSavedConnection(existing.id, { isDefault: true });
+      void connect(existing.id);
+      return;
+    }
+    void addConnectionAndConnect({
+      type: "http",
+      name: HA_CONNECTION_NAME,
+      url,
+    }).then((conn) => updateSavedConnection(conn.id, { isDefault: true }));
+  }, [connect, addConnectionAndConnect]);
+
+  return null;
+}
diff --git a/apps/web/src/core/connections/haAutoConnect.ts b/apps/web/src/core/connections/haAutoConnect.ts
new file mode 100644
