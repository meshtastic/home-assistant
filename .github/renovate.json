{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "conflicted",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "pep621": { "enabled": true },
  "lockFileMaintenance": { "enabled": true },
  "github-actions": { "pinDigests": true },
  "git-submodules": { "enabled": true },
  "packageRules": [
    {
      "description": "The minimum Home Assistant version moves only on purpose, from the dependency dashboard",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["homeassistant"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "These pins are taken from the pinned Home Assistant release and move by hand with it, never on their own",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["pytest-homeassistant-custom-component", "protobuf", "josepy", "bleak"],
      "enabled": false
    }
  ]
}
